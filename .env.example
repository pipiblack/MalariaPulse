# Used server-side by the Streamlit analyst, Node console, and Eve agents.
# Put the real key in ignored .env.local or .streamlit/secrets.toml.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=your_gemini_api_key_here


# Demo-only Streamlit login. Override both values before deployment.
DEMO_USERNAME=admin@malariapulse.demo
DEMO_PASSWORD=DemoPulse!2026

# Optional MCP credentials for a deployed Eve agent. Uncomment both and use a
# secret manager. When omitted, production MCP access fails closed.
# MCP_USERNAME=malariapulse-mcp
# MCP_PASSWORD=replace_with_a_long_random_password

# Port for the legacy Node operations console.
PORT=3000

